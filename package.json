{
  "name": "gipdp-api-test",
  "version": "1.0.0",
  "description": "Real live government procurement API & RSS connectivity test suite for GIPDP",
  "type": "module",
  "scripts": {
    "test:process3": "node process3/test-process3.mjs",
    "test:datago": "node data.go.th/test-datago.mjs",
